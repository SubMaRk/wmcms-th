# อัปโหลดทุกอย่างอยู่ใต้โฟลเดอร์นี้ และห้าม execute อะไรทั้งสิ้น
# แม้ผู้โจมตีจะอัปโหลดไฟล์ .php ได้สำเร็จ ก็เรียกผ่าน HTTP ไม่ได้
<IfModule mod_authz_core.c>
	<FilesMatch "\.(php[0-9]?|phtml|pht|phar|inc|cgi|pl|py|sh|asp|aspx|jsp|htaccess|htpasswd)$">
		Require all denied
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	<FilesMatch "\.(php[0-9]?|phtml|pht|phar|inc|cgi|pl|py|sh|asp|aspx|jsp|htaccess|htpasswd)$">
		Order allow,deny
		Deny from all
	</FilesMatch>
</IfModule>
# ปิดการตีความ PHP ทั้งไดเรกทอรีเป็นชั้นที่สอง
php_flag engine off
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .inc
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar .inc
